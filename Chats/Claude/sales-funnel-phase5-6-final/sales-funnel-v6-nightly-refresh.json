            "index": 0
          }
        ]
      ]
    },
    "Skip Alert - Score Stable": {
      "main": [
        [
          {
            "node": "Log Score History (Postgres)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Score History (Postgres)": {
