# AIOS runtime
RUNTIME_TIMEOUT_SECONDS=120

# Persistent execution/event state
AIOS_DATABASE_URL=postgresql://odoo:change-me-dev-only@postgres:5432/odoo

# n8n is the primary business workflow engine, not an agent runtime.
N8N_RUNTIME_URL=http://n8n:5678

# Agent runtimes / adapters. Never point these back at aios-runtime.
LANGGRAPH_RUNTIME_URL=
CREWAI_RUNTIME_URL=
HERMES_RUNTIME_URL=
DIFY_RUNTIME_URL=

# Odoo CRM adapter
ODOO_URL=http://odoo:8069
ODOO_DB=odoo
ODOO_USERNAME=
ODOO_PASSWORD=

# Infrastructure defaults used by the 08-infrastructure compose stack.
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-dev-only
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me-dev-only
N8N_ENCRYPTION_KEY=change-me-dev-encryption-key
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata
