# AIOS runtime
RUNTIME_TIMEOUT_SECONDS=120

# n8n is the primary business workflow engine.
N8N_RUNTIME_URL=http://n8n:5678

# Optional agent runtimes. Leave blank until their services are deployed.
LANGGRAPH_RUNTIME_URL=
CREWAI_RUNTIME_URL=
HERMES_RUNTIME_URL=
DIFY_RUNTIME_URL=

# Infrastructure defaults used by the 08-infrastructure compose stack.
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-dev-only
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me-dev-only
N8N_ENCRYPTION_KEY=change-me-dev-encryption-key
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata
