# AIOS runtime
RUNTIME_TIMEOUT_SECONDS=120

# Persistent execution/event state
AIOS_DATABASE_URL=postgresql://odoo:change-me-dev-only@postgres:5432/odoo

# n8n is the primary business workflow engine, not an agent runtime.
N8N_RUNTIME_URL=http://n8n:5678

# AIOS gateway points to dedicated adapter services.
LANGGRAPH_RUNTIME_URL=http://langgraph-adapter:8090
CREWAI_RUNTIME_URL=http://crewai-adapter:8090
HERMES_RUNTIME_URL=http://hermes-adapter:8090
DIFY_RUNTIME_URL=http://dify-adapter:8090

# Actual framework/runtime targets behind the adapters.
LANGGRAPH_TARGET_URL=
LANGGRAPH_API_KEY=
LANGGRAPH_ASSISTANT_ID=
LANGGRAPH_INVOKE_PATH=/runs/wait
CREWAI_TARGET_URL=
CREWAI_API_KEY=
HERMES_TARGET_URL=
HERMES_API_KEY=
DIFY_TARGET_URL=
DIFY_API_KEY=
DIFY_WORKFLOW_ID=
DIFY_INVOKE_PATH=/workflows/run

# Odoo CRM adapter
ODOO_URL=http://odoo:8069
ODOO_DB=odoo
ODOO_USERNAME=
ODOO_PASSWORD=
ODOO_SYNC_URL=http://odoo-sync:8091

# Infrastructure defaults used by the 08-infrastructure compose stack.
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-dev-only
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me-dev-only
N8N_ENCRYPTION_KEY=change-me-dev-encryption-key
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata
