{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agents/A034/output.schema.json",
  "title": "A034 Lead Discovery Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["lead_candidates"],
  "properties": {
    "lead_candidates": {"type": "array", "items": {"$ref": "#/$defs/lead"}}
  },
  "$defs": {
    "lead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lead_id", "company_name", "source", "discovery_reason", "confidence", "discovered_at"],
      "properties": {
        "lead_id": {"type": "string", "minLength": 1},
        "company_name": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "discovery_reason": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "discovered_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}