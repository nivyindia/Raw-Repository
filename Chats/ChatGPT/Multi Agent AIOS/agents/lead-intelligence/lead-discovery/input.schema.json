{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A034 Lead Discovery Input",
  "type": "object",
  "required": ["target_definition", "source_policy"],
  "properties": {
    "target_definition": {"type": "object"},
    "source_policy": {"type": "object"},
    "geography": {"type": "string"},
    "industry": {"type": "string"},
    "company_size": {"type": "string"},
    "technology_signals": {"type": "array", "items": {"type": "string"}},
    "intent_signals": {"type": "array", "items": {"type": "string"}},
    "channels": {"type": "array", "items": {"type": "string"}},
    "limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "campaign_id": {"type": "string"},
    "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
