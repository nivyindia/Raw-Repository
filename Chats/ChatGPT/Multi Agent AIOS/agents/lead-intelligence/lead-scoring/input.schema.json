{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"aios://agents/A039/input.schema.json",
  "title":"A039 Lead Scoring Input",
  "type":"object",
  "additionalProperties":false,
  "required":["lead","icp_definition"],
  "properties":{
    "lead":{"type":"object"},
    "icp_definition":{"type":"object"},
    "account_signals":{"type":"array","items":{"type":"object"}},
    "engagement_signals":{"type":"array","items":{"type":"object"}},
    "scoring_policy":{"type":"object"},
    "suppression_status":{"type":"string","enum":["not_suppressed","suppressed","uncertain"]},
    "as_of":{"type":"string","format":"date-time"}
  }
}