{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"aios://agents/A039/output.schema.json",
  "title":"A039 Lead Scoring Output",
  "type":"object",
  "additionalProperties":false,
  "required":["lead_id","score","tier","dimension_scores","confidence","recommended_action","review_required"],
  "properties":{
    "lead_id":{"type":"string"},
    "score":{"type":"number","minimum":0,"maximum":100},
    "tier":{"type":"string","enum":["hot","warm","cold"]},
    "dimension_scores":{"type":"object"},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "positive_signals":{"type":"array","items":{"type":"object"}},
    "negative_signals":{"type":"array","items":{"type":"object"}},
    "score_reasons":{"type":"array","items":{"type":"string"}},
    "evidence":{"type":"array","items":{"type":"object"}},
    "recommended_action":{"type":"string"},
    "review_required":{"type":"boolean"},
    "scoring_policy_version":{"type":"string"},
    "scored_at":{"type":"string","format":"date-time"}
  }
}